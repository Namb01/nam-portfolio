---
import arrowSvg from "../../../public/ddr arrow.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/game.css";
import { CATEGORIES } from "../../data/categories";

// The game screen: every row on the Select Music wheel is a "song", and
// picking one plays it here, at /play/<id>. It's framed like a rhythm game
// mid-song: the two players' life meters along the top with the stage between
// them, two panels along the bottom (the score; links to the other pages),
// and behind everything a backdrop in the colours of the row's jacket art and
// player 1's lane (step arrows, notes on their way up). The lane and backdrop
// are scenery; a page's own content sits on top of them in cards.
// Rows that open a file instead (the resume) get no game screen.
export function getStaticPaths() {
  return CATEGORIES.filter((c) => !c.href).map((c) => ({
    params: { id: c.id },
    props: { title: c.label },
  }));
}

type Props = { title: string };

const { title } = Astro.props;
const id = Astro.params.id as string;

// The page's name in the browser tab, after yours: the row's label in title
// case ("SKILLS" → "Skills"), or a fuller name where it reads better.
const PAGE_NAMES: Record<string, string> = { about: "About Me" };
const pageName = PAGE_NAMES[id] ?? title.charAt(0) + title.slice(1).toLowerCase();

// How full player 1's life meter starts, 0 to 1 (a song starts at half).
const LIFE = 0.5;

// Just for show, like a song in progress: the difficulty played and the
// score so far.
const DIFFICULTY = "STANDARD";
const SCORE = "00428600";

// Filler content for the pages that don't have their real write-up yet.
// Replace these with the real thing.
const PROJECTS = [
  {
    name: "Project One",
    stack: "React / Node.js / MongoDB",
    blurb: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus.",
  },
  {
    name: "Project Two",
    stack: "Python / AWS",
    blurb: "Donec ullamcorper nulla non metus auctor fringilla. Vestibulum id ligula porta felis euismod semper.",
  },
  {
    name: "Project Three",
    stack: "JavaScript / Astro",
    blurb: "Curabitur blandit tempus porttitor. Nullam quis risus eget urna mollis ornare vel eu leo.",
  },
];
// the tools on the Skills jacket art
const SKILLS = [
  { name: "Frontend", items: ["React", "JavaScript"], blurb: "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
  { name: "Backend", items: ["Node.js", "Python", "MongoDB"], blurb: "Donec ullamcorper nulla non metus auctor fringilla." },
  { name: "Cloud", items: ["AWS"], blurb: "Curabitur blandit tempus porttitor nullam quis risus." },
];
// made-up addresses, not real ones
const CONTACTS = [
  { label: "Email", value: "name@example.com" },
  { label: "GitHub", value: "github.com/username" },
  { label: "LinkedIn", value: "linkedin.com/in/username" },
];

// Each page's backdrop takes its colours from that row's jacket art, so the
// page feels like the song you picked: the screen's base colour, the slanted
// band with its rim and the stripe beside it, the two halftone dot fields,
// and the page's own motif (drawn in the backdrop below).
//   about    - electric blue and violet, with light rays (the plasma burst)
//   projects - orange, with thin diagonal lines and yellow stars
//   skills   - purple and magenta with a lime rim, and rows of bubbles
//   contact  - dark teal and aqua, with scan lines, a disc and floor rings
const THEMES: Record<string, Record<string, string>> = {
  about: { bg: "#050A2E", band: "#1A1F9C", rim: "#7C5CFF", stripe: "#C02A6B", "dots-a": "#B36BFF", "dots-b": "#6FB8FF", motif: "#9FD0FF" },
  projects: { bg: "#2A1200", band: "#7A3A00", rim: "#FFB020", stripe: "#FF8A1F", "dots-a": "#FFD23F", "dots-b": "#FF9B5E", motif: "#FFC56B" },
  skills: { bg: "#1E0633", band: "#5A0F7A", rim: "#C9F33D", stripe: "#E0207A", "dots-a": "#FF4FA3", "dots-b": "#3DE3EA", motif: "#FF4FA3" },
  contact: { bg: "#021A1F", band: "#063C46", rim: "#3DE3EA", stripe: "#0B7C8C", "dots-a": "#3DE3EA", "dots-b": "#9FF6F8", motif: "#3DE3EA" },
};
const themeVars = Object.entries(THEMES[id] ?? THEMES.about)
  .map(([name, value]) => `--bd-${name}: ${value}`)
  .join("; ");

// Shapes for the motifs, in the backdrop's 1600 x 900 box.
// about: 14 thin rays fanning out from a point right of centre
const RAYS = Array.from({ length: 14 }, (_, i) => {
  const angle = ((i * 360) / 14) * (Math.PI / 180);
  const half = 5 * (Math.PI / 180);
  const far = (a: number) => `${Math.round(1150 + Math.cos(a) * 1900)},${Math.round(470 + Math.sin(a) * 1900)}`;
  return `1150,470 ${far(angle - half)} ${far(angle + half)}`;
});
// projects: thin lines leaning the same way as the band, and a five-point star
const LINES = Array.from({ length: 16 }, (_, i) => {
  const x = -1000 + i * 170;
  return `${x},900 ${x + 12},900 ${x + 1212},0 ${x + 1200},0`;
});
const STAR = Array.from({ length: 10 }, (_, i) => {
  const r = i % 2 ? 9 : 22;
  const a = (i * 36 - 90) * (Math.PI / 180);
  return `${(Math.cos(a) * r).toFixed(1)},${(Math.sin(a) * r).toFixed(1)}`;
}).join(" ");
// skills: rows of bubbles over the right of the screen, every other row
// shifted half a step, in three colours
const BUBBLES = Array.from({ length: 8 }, (_, row) =>
  Array.from({ length: 9 }, (_, col) => ({
    x: 700 + col * 120 + (row % 2) * 60,
    y: 50 + row * 116,
    tone: (row + col * 2) % 3,
  })),
).flat();
// where the sparkles (or the projects page's stars) sit: [x, y, scale]
const SPARKLES: [number, number, number][] = [
  [1040, 150, 1.5],
  [1420, 250, 0.8],
  [830, 700, 1.1],
  [1500, 760, 1.3],
  [690, 110, 0.7],
];

// The step arrow (public/ddr arrow.svg, pointing up), read when the site is
// built. It's drawn in five layers: an outline, a white rim and three shades
// of blue. Each layer's colour comes from a CSS variable (--arrow-0 to
// --arrow-4, in game.css), so one copy of the arrow serves both the grey step
// zones and the blue notes. Its own colours are the fallback.
const arrowLayers = [...arrowSvg.matchAll(/<path d="([^"]+)" fill="(#[0-9a-fA-F]{6})"/g)].map(([, d, fill], i) => ({
  d,
  style: `fill: var(--arrow-${i}, ${fill})`,
}));

// A still snapshot of notes on their way up to the arrows, like a moment of
// a song's chart. Each has a column (0 left, 1 down, 2 up, 3 right), how far
// below the top of the arrows it is (in arrow heights) and a colour. Two
// notes on one line are a jump. `hold` makes it a freeze arrow: a green note
// with a tail that many arrow heights long. The ones past the bottom of the
// screen are cut off.
type Note = { lane: number; y: number; color: "blue" | "pink" | "yellow" | "green"; hold?: number };
const NOTES: Note[] = [
  { lane: 0, y: 1.5, color: "pink" },
  { lane: 2, y: 2.1, color: "yellow" },
  { lane: 0, y: 2.7, color: "pink" },
  { lane: 3, y: 3.3, color: "blue" },
  { lane: 1, y: 3.9, color: "pink" },
  { lane: 2, y: 3.9, color: "pink" },
  { lane: 0, y: 5.1, color: "blue" },
  { lane: 1, y: 5.7, color: "yellow" },
  { lane: 2, y: 6.3, color: "blue" },
  { lane: 3, y: 6.3, color: "green", hold: 2.4 },
  { lane: 0, y: 7.5, color: "pink" },
  { lane: 1, y: 8.7, color: "yellow" },
  { lane: 2, y: 9.3, color: "pink" },
  { lane: 0, y: 9.9, color: "green", hold: 1.8 },
  { lane: 3, y: 10.5, color: "blue" },
  { lane: 1, y: 11.7, color: "pink" },
  { lane: 2, y: 12.3, color: "yellow" },
];

// left to right, like the pads: each is the up arrow turned to face its way
const ARROWS = [
  { dir: "left", turn: -90 },
  { dir: "down", turn: 180 },
  { dir: "up", turn: 0 },
  { dir: "right", turn: 90 },
];
---

<Base title={`Nam Bui · ${pageName}`}>
  <!-- data-back: Esc returns to the menu on this row -->
  <main class="game" data-back={`/#${id}`} style={`--life: ${LIFE}; ${themeVars}`}>
    <h1 class="visually-hidden">{pageName}</h1>

    <!-- The arrow, drawn once and reused by each step zone and note. -->
    <svg class="defs" aria-hidden="true">
      <symbol id="step-arrow" viewBox="0 0 700 700">
        {arrowLayers.map(({ d, style }) => <path d={d} style={style} fill-rule="evenodd" />)}
      </symbol>
    </svg>

    <!-- The backdrop, in the colours of this row's jacket art (THEMES): a
         slanted band and stripe, the page's own motif, halftone dots and
         sparkles, all dark enough to read over. Stays put when the page
         scrolls. -->
    <svg class="backdrop" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <pattern id="halftone" width="26" height="26" patternUnits="userSpaceOnUse">
          <circle cx="13" cy="13" r="5" />
        </pattern>
        <pattern id="scanlines" width="26" height="26" patternUnits="userSpaceOnUse">
          <rect width="26" height="5" />
        </pattern>
        <path id="sparkle" d="M0 -22 Q3 -3 22 0 Q3 3 0 22 Q-3 3 -22 0 Q-3 -3 0 -22Z" />
        <polygon id="star" points={STAR} />
      </defs>

      {id === "about" && <g class="bd-rays">{RAYS.map((points) => <polygon points={points} />)}</g>}
      {id === "contact" && <rect class="bd-scan" width="1600" height="900" fill="url(#scanlines)" />}

      {/* a slanted band running up to the right, with a hard rim, and a stripe beside it */}
      <polygon class="bd-band" points="-200,900 520,900 1720,0 1000,0" />
      <polygon class="bd-band-rim" points="520,900 560,900 1760,0 1720,0" />
      <polygon class="bd-stripe" points="640,900 760,900 1960,0 1840,0" />

      {id === "projects" && <g class="bd-lines">{LINES.map((points) => <polygon points={points} />)}</g>}
      {
        id === "skills" && (
          <g class="bd-bubbles">
            {BUBBLES.map(({ x, y, tone }) => (
              <g class={`bd-bubble-${tone}`} transform={`translate(${x} ${y})`}>
                <circle r="48" />
                <circle class="bd-shine" cx="-17" cy="-17" r="12" />
              </g>
            ))}
          </g>
        )
      }
      {
        id === "contact" && (
          <g class="bd-rings">
            <circle class="bd-disc" cx="1180" cy="360" r="190" />
            <ellipse cx="1180" cy="800" rx="150" ry="34" />
            <ellipse cx="1180" cy="800" rx="290" ry="66" />
            <ellipse cx="1180" cy="800" rx="430" ry="98" />
            <ellipse cx="1180" cy="800" rx="570" ry="130" />
          </g>
        )
      }

      {/* halftone dot fields in two corners */}
      <polygon class="bd-dots bd-dots-a" points="1600,380 1600,900 1010,900" fill="url(#halftone)" />
      <polygon class="bd-dots bd-dots-b" points="0,0 620,0 0,470" fill="url(#halftone)" />

      {/* four-point sparkles; five-point stars on the projects page */}
      <g class={id === "projects" ? "bd-stars" : "bd-sparkles"}>
        {
          SPARKLES.map(([x, y, scale]) => (
            <use href={id === "projects" ? "#star" : "#sparkle"} transform={`translate(${x} ${y}) scale(${scale})`} />
          ))
        }
      </g>
    </svg>

    <!-- Both players' life meters, with the stage between them. -->
    <header class="hud" aria-hidden="true">
      <div class="gauge gauge-p1">
        <span class="gauge-track"><span class="gauge-fill"></span></span>
      </div>
      <p class="stage">
        <span class="stage-number">1ST</span>
        <span class="stage-word">STAGE</span>
      </p>
      <!-- player 2 hasn't joined, so their meter is empty -->
      <div class="gauge gauge-p2">
        <span class="gauge-track"></span>
      </div>
    </header>

    <!-- Player 1's lane, behind the content: notes on their way up (freeze
         arrows trail a tail). -->
    <div class="notes" aria-hidden="true">
      {
        NOTES.map(({ lane, y, color, hold }) => (
          <>
            {hold && <span class="note-tail" style={`--lane: ${lane}; --y: ${y}; --hold: ${hold}`} />}
            <svg class={`note note-${color}`} viewBox="0 0 700 700" style={`--lane: ${lane}; --y: ${y}`}>
              <use href="#step-arrow" transform={`rotate(${ARROWS[lane].turn} 350 350)`} />
            </svg>
          </>
        ))
      }
    </div>

    <!-- Player 1's step arrows, under their meter, where the notes line up. -->
    <div class="receptors p1" aria-hidden="true">
      {
        ARROWS.map(({ dir, turn }) => (
          <svg class={`receptor receptor-${dir}`} viewBox="0 0 700 700">
            <use href="#step-arrow" transform={`rotate(${turn} 350 350)`} />
          </svg>
        ))
      }
    </div>

    {
      id === "about" && (
        // One card in the middle of the screen, over the lane: its title on a
        // plate on the top edge, the write-up on the left and the headshot on
        // the right.
        <div class="card page-card about-card">
          <h2 id="about-heading" class="card-title">About Me</h2>

          <figure class="about-photo">
            <img src="/headshot.webp" width="640" height="800" alt="Nam Bui" />
          </figure>

          {/* Filler until the real write-up is ready. */}
          <section class="about-text" aria-labelledby="about-heading">
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis
              dapibus posuere velit aliquet. Cras mattis consectetur purus sit amet fermentum, nulla vitae elit
              libero, a pharetra augue.
            </p>
            <p>
              Donec ullamcorper nulla non metus auctor fringilla. Vestibulum id ligula porta felis euismod semper.
              Maecenas faucibus mollis interdum, sed posuere consectetur est at lobortis. Aenean lacinia bibendum
              nulla sed consectetur.
            </p>
            <p>
              Curabitur blandit tempus porttitor. Nullam quis risus eget urna mollis ornare vel eu leo. Etiam porta
              sem malesuada magna mollis euismod.
            </p>
          </section>
        </div>
      )
    }

    {
      id === "projects" && (
        // Filler until the real projects are written up: three tiles, each a
        // screenshot, a name, the stack, a line or two, and where to find it.
        <section class="card page-card" aria-labelledby="projects-heading">
          <h2 id="projects-heading" class="card-title">Projects</h2>
          <ul class="tiles">
            {
              PROJECTS.map((p) => (
                <li class="tile">
                  <div class="tile-shot" aria-hidden="true">
                    <span>Screenshot</span>
                  </div>
                  <h3 class="tile-title">{p.name}</h3>
                  <p class="tile-stack">{p.stack}</p>
                  <p>{p.blurb}</p>
                  {/* plain labels for now; these become links to the live site and the code */}
                  <p class="chips">
                    <span class="chip">Live demo</span>
                    <span class="chip">Source code</span>
                  </p>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }

    {
      id === "skills" && (
        // Filler: the tools shown on the Skills jacket art, in three groups.
        <section class="card page-card" aria-labelledby="skills-heading">
          <h2 id="skills-heading" class="card-title">Skills</h2>
          <p class="card-lead">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus
            posuere velit aliquet.
          </p>
          <div class="groups">
            {
              SKILLS.map((group) => (
                <section class="group">
                  <h3 class="tile-title">{group.name}</h3>
                  <ul class="chips">
                    {group.items.map((item) => <li class="chip">{item}</li>)}
                  </ul>
                  <p>{group.blurb}</p>
                </section>
              ))
            }
          </div>
        </section>
      )
    }

    {
      id === "contact" && (
        // Filler: made-up addresses, shown as plain text until the real ones go in.
        <section class="card page-card contact-card" aria-labelledby="contact-heading">
          <h2 id="contact-heading" class="card-title">Contact</h2>
          <p class="card-lead">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras mattis consectetur purus sit amet
            fermentum.
          </p>
          <dl class="contacts">
            {
              CONTACTS.map((c) => (
                <div class="contact">
                  <dt>{c.label}</dt>
                  <dd>{c.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      )
    }

    <!-- Along the bottom, two separate panels like the two players' score
         boxes, touching the bottom and sides of the screen: player 1's on
         the left (the score, for show) and player 2's on the right, which
         holds the links to the other pages. Each has a slanted tab on top:
         the difficulty over player 1's, Back to the menu over player 2's. -->
    <footer class="hud-bottom">
      <div class="side side-p1" aria-hidden="true">
        <span class="tab difficulty">{DIFFICULTY}</span>
        <p class="score-panel score-panel-p1">
          <span class="score">{SCORE}</span>
        </p>
      </div>
      <div class="side side-p2">
        <a class="tab back" href={`/#${id}`} aria-label="Back to Select Music">
          <span aria-hidden="true">◀</span> Back
        </a>
        <nav class="score-panel score-panel-p2 pages" aria-label="Pages">
          {
            CATEGORIES.map((c) =>
              c.href ? (
                // a file (the resume) opens in its own tab
                <a href={c.href} target="_blank" rel="noopener">
                  {c.label}
                </a>
              ) : (
                <a href={`/play/${c.id}`} aria-current={c.id === id ? "page" : undefined}>
                  {c.label}
                </a>
              ),
            )
          }
        </nav>
      </div>
    </footer>
  </main>

  <script>
    // Esc goes back to Select Music, on the row this song came from.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const back = document.querySelector<HTMLElement>(".game")?.dataset.back;
      if (back) window.location.href = back;
    });
  </script>
</Base>
