---
import Base from "../../layouts/Base.astro";
import "../../styles/game.css";
import { CATEGORIES } from "../../data/categories";
import { themeStyle } from "../../data/themes";
import Backdrop from "../../components/game/Backdrop.astro";
import Meters from "../../components/game/Meters.astro";
import Lane from "../../components/game/Lane.astro";
import ScorePanel from "../../components/game/ScorePanel.astro";
import AboutCard from "../../components/cards/AboutCard.astro";
import ProjectsCard from "../../components/cards/ProjectsCard.astro";
import SkillsCard from "../../components/cards/SkillsCard.astro";
import ContactCard from "../../components/cards/ContactCard.astro";

// The game screen: every row on the Select Music wheel is a "song", and
// picking one plays it here, at /play/<id>. It's framed like a rhythm game
// mid-song. From back to front:
//
//   Backdrop      shapes in the colours of the row's jacket art
//   Lane          player 1's step arrows, and notes on their way up
//   Meters        the two players' life meters along the top
//   the card      the page's own content, the only part that isn't scenery
//   ScorePanel    the score in the bottom left corner, with Back
//
// Rows that open a file instead (the resume) get no game screen.
export function getStaticPaths() {
  return CATEGORIES.filter((c) => !c.href).map((c) => ({
    params: { id: c.id },
    props: { title: c.label },
  }));
}

type Props = { title: string };

const { title } = Astro.props;
const id = Astro.params.id as string;

// The page's name in the browser tab, after yours: the row's label in title
// case ("SKILLS" → "Skills"), or a fuller name where it reads better.
const PAGE_NAMES: Record<string, string> = { about: "About Me" };
const pageName = PAGE_NAMES[id] ?? title.charAt(0) + title.slice(1).toLowerCase();

// Each page's content. To add a page: add its row to src/data/categories.ts,
// write its card in src/components/cards, and list it here.
const CARDS: Record<string, typeof AboutCard> = {
  about: AboutCard,
  projects: ProjectsCard,
  skills: SkillsCard,
  contact: ContactCard,
};
const Card = CARDS[id];
---

<Base title={`Nam Bui · ${pageName}`}>
  <!-- data-back: Esc returns to the menu on this row -->
  <main class="game" data-back={`/#${id}`} style={themeStyle(id)}>
    <h1 class="visually-hidden">{pageName}</h1>

    <Backdrop id={id} />
    <Meters />
    <Lane />
    {Card && <Card />}
    <ScorePanel id={id} />
  </main>

  <script>
    // Esc goes back to Select Music, on the row this song came from.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const back = document.querySelector<HTMLElement>(".game")?.dataset.back;
      if (back) window.location.href = back;
    });
  </script>
</Base>
